{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "piInfrastructureReadPaths": [
    "~/.bun/install/global/node_modules/*",
    "~/Library/pnpm/global/*/node_modules/*",
    "/opt/homebrew/**/@earendil-works/pi-coding-agent/**"
  ],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*/.pi/web-search.json": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "npm-shrinkwrap.json": "ask",
      "package-lock.json": "ask",
      "auth.json": "ask",
      "~/.pi/agent/settings.json": "ask",
      "~/.pi/agent/extensions/pi-permission-system/*": "ask",
      "*/.pi/agent/extensions/pi-permission-system/config.json": "ask",
      "*secret*": "deny",
      "*SECRETS*": "deny",
      "*cert*": "deny",
      "*CERT*": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.p8": "deny",
      "*.pfx": "deny",
      "*.key": "deny",
      "*.keystore": "deny",
      "*.jks": "deny",
      "id_rsa": "deny",
      "id_ed25519": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*id_ecdsa*": "deny",
      "*.ppk": "deny",
      "*/authorized_keys": "deny",
      "*.token": "deny",
      "*.secret": "deny",
      "*.private": "deny",
      "*.secrets": "deny",
      "*.keychain": "deny",
      "*.credentials": "deny",
      ".netrc": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/credentials": "deny",
      "~/.aws/config": "deny",
      "~/.kube/config": "deny",
      "~/Library/Keychains/*": "deny",
      "*/1password/*": "deny",
      "*/1Password/*": "deny",
      "*/passwords/*": "deny",
      "*/Passwords/*": "deny",
      "*/wallet/*": "deny",
      "*/Wallet/*": "deny",
      "~/Library/Application Support/Firefox/*": "deny",
      "~/Library/Application Support/Brave/*": "deny",
      "~/Library/Messages/*": "deny",
      "~/Library/Mail/*": "deny"
    },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "find *": "allow",
      "mdfind *": "allow",
      "grep *": "allow",
      "date *": "allow",
      "less *": "allow",
      "echo *": "allow",
      "env *": "ask",
      "pwd": "allow",
      "ssh *": "ask",
      "make *": "allow",
      "nc *": "ask",
      "netcat": "ask",
      "fffind": "allow",
      "fffind *": "allow",
      "nmap *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "rg *": "allow",
      "brew": "ask",
      "eslint *": "allow",
      "sort *": "allow",
      "prettier *": "allow",
      "npm run *": "allow",
      "pnpm run *": "allow",
      "pip install *": "ask",
      "pip3 install *": "ask",
      "sha256sum *": "allow",
      "claude *": "ask",
      "cc *": "ask",
      "cd *": "allow",
      "npm run list *": "allow",
      "bun pm ls *": "allow",
      "npm view *": "allow",
      "ccd *": "ask",
      "rsync *": "ask",
      "ncat *": "ask",
      "tcpdump *": "ask",
      "hf *": "allow",
      "go test *": "allow",
      "sed -n *": "allow",
      "sed -i *": "ask",
      "sed * -i *": "ask",
      "gh issues list *": "allow",
      "gh pr list *": "allow",
      "gh pr checkout *": "allow",
      "gh pr view *": "allow",
      "gh issue view *": "allow",
      "gh repo view *": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git diff *": "allow",
      "git checkout *": "allow",
      "git show *": "allow",
      "git fetch *": "allow",
      "git remote *": "allow",
      "git pull *": "allow",
      "git clone *": "ask",
      "git branch": "allow",
      "git stash": "allow",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git log *": "allow",
      "git status": "allow",
      "scp": "ask",
      "killall": "ask",
      "kill *": "ask",
      "pkill *": "ask",
      "tree *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "which *": "allow",
      "diff *": "allow",
      "jq *": "allow",
      "rm *": "ask",
      "npm install *": "ask",
      "npm i *": "ask",
      "pnpm install *": "ask",
      "pnpm i *": "ask",
      "pnpx *": "ask",
      "npx *": "ask",
      "mv *": "ask",
      "cp *": "allow",
      "chmod *": "ask",
      "chmod -R 777 *": "deny",
      "sudo *": "deny",
      "du *": "allow",
      "markdownlint *": "allow",
      "shellcheck *": "allow",
      "gofmt *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "uniq *": "allow",
      "column *": "allow",
      "awk *": "allow",
      "awk *system(*": "ask",
      "awk * | sh*": "ask",
      "awk * | bash*": "ask",
      "cp /dev/null *": "ask",
      "truncate -s 0 *": "ask",
      "truncate -s0 *": "ask",
      "chown -R *": "ask",
      "dd *": "ask",
      "diskutil *": "ask",
      "git checkout -- *": "ask",
      "git reset --hard *": "ask",
      "git clean -fd*": "ask",
      "git clean -ffd*": "ask",
      "su *": "deny",
      "security *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      "mkfs *": "deny",
      "1password *": "deny",
      "1Password *": "deny",
      "rm .": "deny",
      "rm ./": "deny",
      "rm * .": "deny",
      "rm * ./": "deny",
      "rm ..": "deny",
      "rm ../": "deny",
      "rm * ..": "deny",
      "rm * ../": "deny",
      "rm /": "deny",
      "rm * /": "deny",
      "rm ~": "deny",
      "rm ~/": "deny",
      "rm * ~": "deny",
      "rm * ~/": "deny",
      "rm $HOME": "deny",
      "rm $HOME/": "deny",
      "rm * $HOME": "deny",
      "rm * $HOME/": "deny",
      "rm ${HOME}": "deny",
      "rm ${HOME}/": "deny",
      "rm * ${HOME}": "deny",
      "rm * ${HOME}/": "deny",
      "rm \"$HOME\"": "deny",
      "rm \"$HOME\"/": "deny",
      "rm * \"$HOME\"": "deny",
      "rm * \"$HOME\"/": "deny",
      "rm /Users/samm": "deny",
      "rm /Users/samm/": "deny",
      "rm * /Users/samm": "deny",
      "rm * /Users/samm/": "deny",
      "rm \"/Users/samm\"": "deny",
      "rm * \"/Users/samm\"": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.pi/agent*": "allow",
      "~/git/*": "allow",
      "~/.agents/skills/*": "allow",
      "~/Library/pnpm/*": "allow",
      "~/.bun/*": "allow",
      "/tmp/*": "allow"
    }
  }
}
