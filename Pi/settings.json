{
  "$schema": "./.schemas/settings.schema.json",
  "ayu": {
    "checkpoint": {
      "exclude": [
        ".ssh/**",
        "**/.ssh/**",
        "**/node_modules/**",
        "**/.venv/**",
        ".gnupg/**",
        ".aws/**",
        ".graphify-out/**",
        "graphify-out/**",
        ".config/gh/**",
        "**/id_rsa*",
        "**/id_ecdsa*",
        "**/id_ed25519*",
        "**/*.pem",
        "**/*.key",
        ".rustup/**",
        ".bun/**",
        ".local/**",
        ".npm/**",
        ".cargo/**",
        ".claude/**",
        ".pi/**",
        ".pi-lens/**",
        ".agents/**",
        "go/pkg/**"
      ],
      "maxFileMB": 3
    }
  },
  "compaction": {
    "keepRecentTokens": 30000
  },
  "defaultThinkingLevel": "medium",
  "enableInstallTelemetry": false,
  "npmCommand": [
    "bun",
    "--minimum-release-age=0"
  ],
  "packages": [
    "npm:context-mode",
    "npm:pi-markdown-preview",
    "npm:@ayulab/pi-rewind",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-sandbox",
    "npm:pi-web-access",
    "npm:cc-safety-net",
    "npm:@ff-labs/pi-fff",
    "npm:@narumitw/pi-plan-mode",
    "npm:pi-mcp-adapter",
    "npm:pi-context-view",
    "npm:@mrclrchtr/supi-ask-user"
  ],
  "showCacheMissNotices": true,
  "terminal": {
    "showTerminalProgress": true
  },
  "theme": "nebula-pulse"
}
