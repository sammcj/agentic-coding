+def _mps_bmm_attention(q, k, v, block=1024):
+    """Non-causal attention as bmm + bf16 softmax + bmm for MPS.
+
+    PyTorch's MPS SDPA kernel tops out near 4 TFLOPS at YuE2's NAR shapes;
+    explicit matmuls with a low-precision softmax measured 3.6x faster.
+    Set YUE2_MPS_SDPA=1 to fall back to the stock SDPA path.
+    """
+    groups = q.shape[1] // k.shape[1]
+    qh = q.transpose(0, 1)
+    khT = k.transpose(0, 1).repeat_interleave(groups, 0).transpose(1, 2)
+    vh = v.transpose(0, 1).repeat_interleave(groups, 0)
+    scale = q.shape[-1] ** -0.5
+    outputs = []
+    for start in range(0, len(q), block):
+        scores = torch.bmm(qh[:, start:start + block], khT) * scale
+        outputs.append(torch.bmm(torch.softmax(scores, -1), vh))
+    return torch.cat(outputs, 1).transpose(0, 1)
+
