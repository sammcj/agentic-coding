+    from .storage import MODEL_FILES, MODEL_LICENSES, sha256_file, write_json
+
+    if quantization_status(model)["mode"] != "int8":
+        raise ValueError("Run prepare_int8_ar before exporting")
+    source_dir, destination = Path(source_dir), Path(destination)
+    destination.mkdir(parents=True, exist_ok=True)
+    for name in sorted(MODEL_FILES - {"config.json", "weights_manifest.json"}):
+        if (source_dir / name).exists() and not name.endswith(".safetensors") and name != "model.safetensors.index.json":
+            shutil.copy2(source_dir / name, destination / name)
+    (destination / "licenses").mkdir(exist_ok=True)
+    for name in sorted(MODEL_LICENSES):
+        if (source_dir / "licenses" / name).exists():
+            shutil.copy2(source_dir / "licenses" / name, destination / "licenses" / name)
+    state = {key: value.detach().contiguous().cpu() for key, value in model.state_dict().items()}
+    save_file(state, destination / "model.safetensors", metadata={"format": "pt"})
+    config = json.loads((source_dir / "config.json").read_text())
+    config["quantization_config"] = {
+        "method": INT8_CHECKPOINT_METHOD, "weight_dtype": "int8", "scale_dtype": "bfloat16",
+        "granularity": "per_output_channel_symmetric", "modules": AR_LINEAR.pattern,
+        "unquantized": ["embed_tokens", "lm_head", "nar_*", "norms", "vae2llm", "llm2vae", "time_embedder"],
+        "source_weights_sha256": json.loads((source_dir / "weights_manifest.json").read_text())["files"],
+    }
+    write_json(destination / "config.json", config)
+    write_json(destination / "weights_manifest.json", {"schema": 1, "files": {
+        "model.safetensors": {"bytes": (destination / "model.safetensors").stat().st_size,
+                              "sha256": sha256_file(destination / "model.safetensors")}}})
+    return destination
