+def load_int8_ar_checkpoint(model_dir, device):
+    """Load a checkpoint written by ``export_int8_ar``: int8 AR linears, everything else BF16.
+
+    No BF16 originals exist, so ``restore_ar`` is a no-op and the NAR prefix
+    prefill also runs through the dequantized AR weights.
+    """
+    from accelerate import init_empty_weights
+    from safetensors.torch import load_file
+    from .modeling_yue2 import YuE2Config, YuE2ForCausalLM
+
+    model_dir = Path(model_dir)
+    raw = json.loads((model_dir / "config.json").read_text())
+    method = (raw.get("quantization_config") or {}).get("method")
+    if method != INT8_CHECKPOINT_METHOD:
+        raise ValueError(f"Expected quantization_config.method {INT8_CHECKPOINT_METHOD!r}, found {method!r}")
+    # PretrainedConfig drops or reinterprets quantization_config, so the raw JSON is checked above.
+    config = YuE2Config.from_pretrained(model_dir)
+    with init_empty_weights():
+        model = YuE2ForCausalLM(config).to(torch.bfloat16)
+    for name, module in [(n, m) for n, m in model.named_modules() if AR_LINEAR.fullmatch(n)]:
+        _replace(model, name, Int8Linear(module, device))
+    state = {}
+    for file in sorted(model_dir.glob("*.safetensors")):
+        state.update(load_file(file, device="cpu"))
+    missing, unexpected = model.load_state_dict(state, strict=False, assign=True)
+    if missing or unexpected:
+        raise ValueError(f"Checkpoint mismatch: missing {list(missing)[:3]}, unexpected {list(unexpected)[:3]}")
+    object.__setattr__(model, "_yue2_fp8_originals", {})
+    object.__setattr__(model, "_yue2_quant_mode", "int8")
+    return model.eval()
