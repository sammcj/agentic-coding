+class Int8Linear(nn.Module):
+    """Per-output-channel symmetric int8 weights, BF16 activations and output.
+
+    Decode-sized inputs use ``torch._weight_int8pack_mm`` (MPS/CPU kernels);
+    larger inputs dequantize and run the ordinary GEMM, which measured faster
+    than the packed kernel above a few dozen rows on MPS. CUDA has no packed
+    kernel in torch 2.10 and always takes the dequantized GEMM.
+    """
+    PACKED_MAX_ROWS = 32
+    PACKED_DEVICES = ("mps", "cpu")
+
+    def __init__(self, linear, device):
+        super().__init__()
+        self.in_features, self.out_features = linear.in_features, linear.out_features
+        if linear.weight.device.type == "meta":
+            # Skeleton for a pre-quantized checkpoint; load_state_dict(assign=True) fills it.
+            weight = torch.empty(self.out_features, self.in_features, dtype=torch.int8, device="meta")
+            scale = torch.empty(self.out_features, dtype=torch.bfloat16, device="meta")
+            bias = torch.empty(self.out_features, dtype=torch.bfloat16, device="meta") if linear.bias is not None else None
+        else:
+            source = linear.weight.detach().to(torch.bfloat16)
+            scale = source.abs().amax(1, keepdim=True).clamp_min(1e-8) / 127
+            weight = (source.float() / scale.float()).round().clamp(-128, 127).to(torch.int8).to(device)
+            scale = scale.squeeze(1).to(device)
+            bias = linear.bias.detach().clone().to(device) if linear.bias is not None else None
+        self.register_buffer("weight", weight)
+        self.register_buffer("weight_scale", scale)
+        self.register_buffer("bias", bias)
+
+    def forward(self, value):
+        if value.dtype != torch.bfloat16:
+            raise ValueError("Int8 AR expects BF16 input")
+        rows = value.reshape(-1, self.in_features)
+        if rows.shape[0] <= self.PACKED_MAX_ROWS and value.device.type in self.PACKED_DEVICES:
+            output = torch._weight_int8pack_mm(rows.contiguous(), self.weight, self.weight_scale)
+            if self.bias is not None:
+                output = output + self.bias
+        else:
+            output = F.linear(rows, self.dequantized_weight(), self.bias)
+        return output.reshape(*value.shape[:-1], self.out_features)
+
+    def dequantized_weight(self):
+        return self.weight.to(torch.bfloat16) * self.weight_scale[:, None]
+
