+def _mps_decode_attention(query, key, value):
+    """Unmasked attention as grouped bmm + softmax + bmm.
+
+    PyTorch's MPS SDPA takes ~1.3 ms per layer for one query against a 10k
+    token cache; the explicit matmul form measured ~0.12 ms with identical
+    output to bf16 precision. Only used for short unmasked queries (decode).
+    """
+    B, H, T, D = query.shape
+    Hk, S = key.shape[1], key.shape[2]
+    groups = H // Hk
+    q = query.reshape(B, Hk, groups * T, D).reshape(B * Hk, groups * T, D)
+    k = key.reshape(B * Hk, S, D)
+    v = value.reshape(B * Hk, S, D)
+    scores = torch.bmm(q, k.transpose(1, 2)) * (D ** -0.5)
+    out = torch.bmm(torch.softmax(scores, -1), v)
+    return out.reshape(B, Hk, groups, T, D).reshape(B, H, T, D)
 
 
